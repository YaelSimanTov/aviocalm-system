# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=aviocalm
DB_USER=your_pg_username
DB_PASSWORD=your_pg_password

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret

# ─── ngrok Tunnel (local dev only) ────────────────────────────────────────────
# Set this to your ngrok public URL after running the tunnel.
# See the "Hardware Connection" section in README.md.
NGROK_URL=https://your-ngrok-domain.ngrok-free.dev
